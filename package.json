{
	"name": "sc-gate-dl",
	"module": "src/index.ts",
	"type": "module",
	"private": true,
	"repository": {
		"type": "git",
		"url": "https://github.com/D3SOX/sc-gate-dl"
	},
	"author": {
		"name": "D3SOX",
		"url": "https://github.com/D3SOX"
	},
	"license": "AGPL-3.0-or-later",
	"scripts": {
		"start": "bun run .",
		"manage-acc": "bun run ./src/manageAccount.ts",
		"start:server": "bun run ./src/server.ts",
		"dev:server": "bun --watch ./src/server.ts",
		"dev:webui": "cd webui && bun run dev",
		"webui": "bun run --parallel dev:server dev:webui",
		"build:webui": "cd webui && bun run build",
		"start:webui": "bun run ./src/webuiServer.ts",
		"serve": "bun run build:webui && bun run --parallel start:server start:webui",
		"lint": "biome check .",
		"lint:fix": "biome check --fix .",
		"typecheck": "tsc --noEmit && tsc --noEmit -p webui",
		"test": "bun test --path-ignore-patterns='**/*.browser.test.ts' --path-ignore-patterns='**/*.live.test.ts'",
		"test:browser": "bun test browser.test",
		"test:live": "LIVE_TESTS=1 bun test live.test"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.8",
		"@types/bun": "^1.4.4",
		"@types/cli-progress": "^3.11.6",
		"typescript": "^7.0.2"
	},
	"dependencies": {
		"@inquirer/prompts": "^8.8.0",
		"cli-progress": "^3.12.0",
		"cloakbrowser": "^0.6.5",
		"find-bin": "^1.1.1",
		"mmdb-lib": "^3.0.5",
		"puppeteer": "^25.18.1",
		"socks-proxy-agent": "^10.1.0",
		"soundcloud.ts": "^0.7.4"
	},
	"patchedDependencies": {
		"soundcloud.ts@0.7.4": "patches/soundcloud.ts@0.7.4.patch"
	}
}
