HYPEDDIT_NAME=
HYPEDDIT_EMAIL=
# Name/email are optional — only needed when a Hypeddit, GateRush, or Droploud gate asks for them.
# Droploud requires at least 2 characters when a SoundCloud comment step is present.
SC_COMMENT=Fire track!
SC_CLIENT_ID=
# The app renews its login with SC_REFRESH_TOKEN and saves the newest tokens
# to soundcloud-token.json. SC_OAUTH_TOKEN alone stops working after 24 hours.
SC_REFRESH_TOKEN=
SC_OAUTH_TOKEN=
# Optional — only used by `bun manage-acc` to export a *separate* SoundCloud account
# (follows/likes/reposts/playlists → ./exports). Not used by the downloader; leave blank otherwise.
MANAGED_SC_CLIENT_ID=
MANAGED_SC_OAUTH_TOKEN=
# Optional residential proxy when SoundCloud DataDome hard-blocks engagement PUTs
# (repost/like/comment). DELETE cleanup is not DataDome-protected and works without this.
# SC_API_PROXY=http://user:pass@host:port
# CLOAKBROWSER_PROXY=http://user:pass@host:port
# PROXY_URL=http://user:pass@host:port
# WebUI browser jobs default to headless (also toggleable per job in the UI).
# Set false to force headed for all jobs when the UI option is not sent.
# BROWSER_HEADLESS=false
# Disable Chromium GPU access on hosts where rendering otherwise fails.
# SC_GATE_DL_DISABLE_GPU=true
# Avoid /dev/shm when it is too small, such as in some containers.
# SC_GATE_DL_DISABLE_DEV_SHM=true
# Proxy timezone/locale matching is automatic; uncomment only to disable it.
# CLOAKBROWSER_GEOIP=false
# Server only: port of the API and Web UI backend (default 3000). Must be a whole
# number from 1 to 65535 (0 is rejected: it would pick a random port); an invalid
# value stops the server at startup.
# SC_GATE_DL_PORT=3000
# Server only: extra browser origins allowed to send POST requests, comma-separated,
# for a Web UI behind a reverse proxy with its own address.
# SC_GATE_DL_ALLOWED_ORIGINS=https://downloads.example.com
# Server only: URL of the remote browser view (noVNC) for headed jobs. Use {host}
# to reuse the host the Web UI was opened on.
# BROWSER_VIEW_URL=http://{host}:6080/vnc.html?autoconnect=true&resize=scale
# Server only: delete the completed MP3/FLAC/original file after its HTTP
# response is fully transferred. Cancelled or failed transfers keep the file.
# Applies to headless, Xvfb, and visible-headed jobs.
# SC_GATE_DL_DELETE_AFTER_DOWNLOAD=true
# CLI only: folder where finished downloads are saved. Unset keeps them in
# ./downloads. Relative paths resolve from the working directory; ~ and ~/...
# expand to your home folder. Missing folders are created, and existing files
# are never overwritten. A retained lossless source is saved there too.
# SC_GATE_DL_CLI_DIR=~/Music/SoundCloud
# CLI only: format of the finished file. mp3 (default) uses SC_GATE_DL_BITRATE,
# m4a-aac uses SC_GATE_DL_BITRATE for AAC, flac is lossless and ignores the
# bitrate, and original keeps the selected audio as downloaded (no conversion,
# retagging, or artwork). Only verified lossless sources are converted; lossy
# files keep their codec. An unknown value stops the CLI before any gate opens.
# SC_GATE_DL_CLI_FORMAT=mp3
# Server only: folder inside your music library where API clients such as
# Nevumi save finished downloads ("destination": "library" jobs).
# SC_GATE_DL_LIBRARY_DIR=/home/YOUR_USER/Music/SoundCloud
# Shared bitrate in kbps for configurable MP3 and M4A/AAC output (format `mp3` or
# `m4a-aac`), used by both the server and the CLI. Unset means 320. MP3 accepts 32, 40, 48, 56, 64,
# 80, 96, 112, 128, 160, 192, 224, 256, 320; AAC accepts whole numbers 64–320.
# Invalid values reject the job. This replaces SC_GATE_DL_AAC_BITRATE, which is
# no longer read: move its value to SC_GATE_DL_BITRATE, otherwise AAC returns to 320.
# SC_GATE_DL_BITRATE=320

# Web UI build only (not read by the server at runtime): the API base URL is
# baked in when the Web UI is built. Changing this value needs a rebuild of the
# Web UI; restarting the server does not update an already-built bundle.
# PUBLIC_API_BASE_URL=http://localhost:3000

# CLI and server: whether metadata is reviewed by hand. Unset or `false` (case-insensitive)
# processes downloads automatically with the SoundCloud metadata, supported artwork and the
# source-link comment, without tag prompts. `true` keeps the interactive tag review (CLI) and
# makes unattended server jobs wait for tags unless the request sets `reviewTags`. Any other
# value, including blank, stops startup naming this setting.
# SC_GATE_DL_REVIEW_TAGS=false
