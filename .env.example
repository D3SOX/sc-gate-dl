# sc-gate-dl settings. Copy to .env. Every line below shows: what it does,
# the default, and the allowed values. Unset or blank means the default.
# Full reference: docs/configuration.md.

# ---------------------------------------------------------------- Gate forms
# Name/email for gates that ask for them (Hypeddit, GateRush, Droploud).
# Default: none. Values: any text / any valid email.
HYPEDDIT_NAME=
HYPEDDIT_EMAIL=
# Comment posted on SoundCloud by comment gates. REQUIRED.
# Default: none. Values: text of at least 2 characters (Droploud needs 2+).
SC_COMMENT=Fire track!

# Optional: your own (throwaway) account names. Some StillHype follow steps ask
# for them; unset ones are asked for in the remote browser instead.
# Default: none. Values: the account name on that service.
# INSTAGRAM_HANDLE=
# TIKTOK_HANDLE=
# X_HANDLE=
# YOUTUBE_HANDLE=

# ---------------------------------------------------- SoundCloud login (required)
# Easiest: leave these three empty and run `bun start --login`. The guided login
# opens a browser and writes them here (file mode 600, other lines kept).
# SC_CLIENT_ID: web client id. SC_REFRESH_TOKEN: cookie `oauth_refresh_token`.
# SC_OAUTH_TOKEN: access token, valid 24 h; the app renews it and rewrites it
# here together with a NEW refresh token on every renewal (the old one dies).
# Default: none. Values: strings copied from soundcloud.com.
SC_CLIENT_ID=
SC_REFRESH_TOKEN=
SC_OAUTH_TOKEN=
# Spotify has no .env entry: its login is stored in spotify-cookies.json
# (created by `bun start --login`).

# Optional: a SEPARATE account for `bun manage-acc` (exports follows/likes/
# reposts/playlists to ./exports). Not used by the downloader.
# Default: none.
MANAGED_SC_CLIENT_ID=
MANAGED_SC_OAUTH_TOKEN=

# ------------------------------------------------------------------ Output
# CLI: folder for finished downloads. Default: ./downloads.
# Values: path; relative to the working dir; ~ and ~/... expand. Missing folders
# are created, existing files are never overwritten.
# SC_GATE_DL_CLI_DIR=~/Music/SoundCloud
# CLI: format of the finished file. Default: mp3.
# Values: mp3 | m4a-aac | flac | original (no conversion, no retagging, no artwork).
# Only verified lossless sources are converted. Unknown value stops the CLI.
# SC_GATE_DL_CLI_FORMAT=mp3
# MP3/AAC bitrate in kbps, CLI and server. Default: 320.
# Values: MP3 32 40 48 56 64 80 96 112 128 160 192 224 256 320; AAC 64-320.
# Invalid values reject the job. Replaces SC_GATE_DL_AAC_BITRATE (no longer read).
# SC_GATE_DL_BITRATE=320
# Review tags by hand (CLI prompt; server jobs wait for tags). Default: false.
# Values: true | false (case-insensitive). Anything else stops startup.
# A request's `reviewTags` always wins; GET /api/capabilities reports the default.
# SC_GATE_DL_REVIEW_TAGS=false

# ------------------------------------------------------------- Server only
# Port of the API and Web UI backend. Default: 3000. Values: whole number 1-65535.
# SC_GATE_DL_PORT=3000
# Extra browser origins allowed to POST (Web UI behind a reverse proxy).
# Default: none. Values: comma-separated origins.
# SC_GATE_DL_ALLOWED_ORIGINS=https://downloads.example.com
# URL of the remote browser view (noVNC) for headed jobs. Default: none.
# Values: http(s) URL; {host} is replaced by the host the Web UI was opened on.
# BROWSER_VIEW_URL=http://{host}:6080/vnc.html?autoconnect=true&resize=scale
# Browser mode of new Web UI jobs when the UI sends none. Default: headless.
# Values: false forces headed.
# BROWSER_HEADLESS=false
# Folder in your music library for "destination": "library" jobs (e.g. Nevumi).
# Default: none. Values: absolute path.
# SC_GATE_DL_LIBRARY_DIR=/home/YOUR_USER/Music/SoundCloud
# Delete the finished file after the HTTP response completed. Default: false.
# Values: true | false. Cancelled or failed transfers keep the file.
# SC_GATE_DL_DELETE_AFTER_DOWNLOAD=true

# ------------------------------------------------- Browser and network
# Residential proxies when SoundCloud DataDome blocks engagement PUTs.
# Default: none. Values: URL like http://user:pass@host:port (SOCKS5 preferred).
# SC_API_PROXY=http://user:pass@host:port
# CLOAKBROWSER_PROXY=http://user:pass@host:port
# PROXY_URL=http://user:pass@host:port
# Proxy timezone/locale matching. Default: on. Values: false turns it off.
# CLOAKBROWSER_GEOIP=false
# Platform workarounds. Default: off. Values: true.
# SC_GATE_DL_DISABLE_GPU=true
# SC_GATE_DL_DISABLE_DEV_SHM=true

# Web UI build only (baked into the bundle; rebuild after changing).
# Default: http://localhost:3000.
# PUBLIC_API_BASE_URL=http://localhost:3000

# Test-only controls (SC_GATE_DL_TEST_FIXTURE_*, SC_GATE_DL_SECOND_VOLUME,
# SC_GATE_DL_ENV_FILE) are not configuration and are deliberately not listed.
